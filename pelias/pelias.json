{
  "esclient": {
    "apiVersion": "7.x",
    "hosts": [
      {
        "host": "elasticsearch",
        "port": 9200
      }
    ]
  },

  "api": {
    "parser": {
      "host": "parser",
      "port": 4400
    },
    "placeholder": {
      "url": "http://placeholder:4100"
    },
    "pip": {
      "url": "http://pip_service:3102",
      "timeout": 1000,
      "retries": 2
    }
  },

  "imports": {
    "openstreetmap": {
      "download": [
        {
          "sourceURL": "https://download.geofabrik.de/south-america/bolivia-latest.osm.pbf"
        }
      ],
      "bounding_box": {
        "min_lat": -16.677526,
        "max_lat": -16.409631,
        "min_lon": -68.332546,
        "max_lon": -67.935321
      },
      "datapath": "/mnt/pelias/openstreetmap",
      "import": [
        {
          "poi": {
            "require_name": true,
            "types": ["node"]
          },
          "address": {
            "interpolation": false
          },
          "filename": "bolivia-latest.osm.pbf"
        }
      ]
    },
    "whosonfirst": {
      "datapath": "/mnt/pelias/whosonfirst",
      "importPostalcodes": false,
      "countryCode": "BO"
    }
  }
}
